{
  "name": "norm",
  "private": true,
  "version": "0.1.0",
  "description": "Norm — serverless AI relay: BYOK, Ed25519 identity, per-request isolation billing, verifiable upstream provenance, ZDR by trusted publishing.",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "dev": "wrangler dev --config wrangler.jsonc --port 8787",
    "preview": "vite --port 5173",
    "db:migrate:local": "wrangler d1 migrations apply norm --local --config wrangler.jsonc",
    "db:migrate": "wrangler d1 migrations apply norm --remote --config wrangler.jsonc",
    "deploy": "pnpm build && wrangler deploy --config wrangler.jsonc",
    "attest": "node scripts/attest.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.2.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^8.21.3",
    "auth-mini-react-components": "^0.6.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "hono": "^4.13.14",
    "linkit-react-components": "^0.6.3",
    "lucide-react": "^1.42.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.5",
    "wrangler": "4.152.0"
  }
}
