{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "norm",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  // 关闭每请求自动生成的 invocation_logs（省 1,320 纳/次），保留应用日志（console.error / 异常堆栈）；
  // 临时查线上实时全量流用免费的 wrangler tail。
  "observability": {
    "logs": { "enabled": true, "invocation_logs": false }
  },

  // 单源部署：SPA 与 API 同域同版本，没有跨域，也没有版本错配。
  // 仅 /api/* 与 /v1/* 进 Worker；静态资源（HTML/JS/CSS/SVG）由 Cloudflare 边缘免费直出（0 Worker 调用）。
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/v1/*"],
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "norm",
      "database_id": "0e9f0b7f-0e98-4451-8103-a96a17e5a197",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // 余额安全阈值（纳美元）：余额低于此值时在转发入口直接 402 拒绝，0 D1 写、0 上游请求。
    // 动态 Gas 操作码单价表写在 src/gas.ts（随代码进入 source_sha256 可复现校验），不放部署变量里。
    "MIN_BALANCE_NANOS": "10000",
    // 签名时间窗：只校验请求是否新鲜，浏览器 ↔ Worker 全程走 TLS，不维护服务端 nonce 状态。
    "SIGNATURE_WINDOW_SECONDS": "60",
    // 亲和有效期：一个 thread-id / session-id 在这段时间里留在同一条上游上。
    "AFFINITY_TTL_SECONDS": "604800",
    // 可以往公共池里放上游的地址（逗号分隔，空 = 谁都不行）。
    // 地址是 Ed25519 公钥，不是秘密；但它决定「谁能让全站用自己的密钥」，所以是显式清单。
    // 这一条是站点主账户：池子里的上游都用它的密钥付钱、替全站兜底。
    "POOL_ADMIN_ADDRESSES": "75A9RSbK1rvZUQ1ZA8Wp247AwutTJhUdTJ9dt77YtkY5",
    // 信任清单：只有落在这些主机上的上游提供商才会被前端标成「官方」。
    // 精确主机名匹配，不做后缀匹配（api.openai.com.evil.tld 不该被放进来）。
    "TRUSTED_BASE_URLS": "api.openai.com,api.deepseek.com,api.anthropic.com,generativelanguage.googleapis.com,api.x.ai,api.moonshot.cn,open.bigmodel.cn,dashscope.aliyuncs.com,opencode.ai,chatgpt.com",
    // 可信发布证明：CI 在 deploy 时用 --var 覆盖，公开在 /api/v1/attestation。
    "ATTEST_COMMIT": "dev",
    "ATTEST_BUILT_AT": "dev",
    "ATTEST_SOURCE_SHA256": "dev",
    "ATTEST_ASSETS_SHA256": "dev",
    "ATTEST_RUN_URL": "dev"
  },

  "routes": [{ "pattern": "norm.ntnl.io", "custom_domain": true }]
}
