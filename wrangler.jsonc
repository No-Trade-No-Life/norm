{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "norm",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // 单源部署：SPA 与 API 同域同版本，没有跨域，也没有版本错配。
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "norm",
      "database_id": "0e9f0b7f-0e98-4451-8103-a96a17e5a197",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // Norm 的服务费：每一次被隔离执行的调用固定收一笔，纳美元（300 纳美元 = $0.0000003）。
    // token 那部分由 src/pricing.ts 的价目表算，不在这里——价格要跟着代码一起可复现。
    "SERVICE_FEE_NANOS": "300",
    // 新地址的演示授信。
    "GRANT_NANOS": "1000000000",
    // 签名时间窗。
    "SIGNATURE_WINDOW_SECONDS": "120",
    // 信任清单：只有落在这些主机上的上游提供商才会被前端标成「官方」。
    // 精确主机名匹配，不做后缀匹配（api.openai.com.evil.tld 不该被放进来）。
    "TRUSTED_BASE_URLS": "api.openai.com,api.deepseek.com,api.anthropic.com,generativelanguage.googleapis.com,api.x.ai,api.moonshot.cn,open.bigmodel.cn,dashscope.aliyuncs.com",
    // 可信发布证明：CI 在 deploy 时用 --var 覆盖，公开在 /api/v1/attestation。
    "ATTEST_COMMIT": "dev",
    "ATTEST_BUILT_AT": "dev",
    "ATTEST_SOURCE_SHA256": "dev",
    "ATTEST_ASSETS_SHA256": "dev",
    "ATTEST_RUN_URL": "dev"
  },

  "routes": [{ "pattern": "norm.ntnl.io", "custom_domain": true }]
}
